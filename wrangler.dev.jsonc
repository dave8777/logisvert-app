// Config pour le développement LOCAL seulement (`wrangler dev -c wrangler.dev.jsonc`).
// Identique à wrangler.jsonc SANS la liaison Workers AI : celle-ci n'a pas de
// simulateur local et exige une connexion au compte Cloudflare. Sans elle,
// l'API /api/nameplate répond `reading: null` (dégradation prévue).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "logisvert-calculator",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "dpsd-estimates"
    }
  ]
}
