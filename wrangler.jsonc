{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "logisvert-calculator",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "dpsd-estimates"
    }
  ],
  "vars": {
    // Sales app to notify after each virtual-estimate booking; the shared
    // key is a secret: npx wrangler secret put SALES_LEAD_KEY
    "SALES_SYNC_URL": "https://sales.dpsdair.ca"
  },
  "ai": {
    "binding": "AI"
  }
}
